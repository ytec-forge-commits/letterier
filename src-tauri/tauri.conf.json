{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "レタリエ",
  "mainBinaryName": "レタリエ",
  "version": "1.0.3",
  "identifier": "jp.ytec.binsen-kobo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../.local/frontend"
  },
  "app": {
    "windows": [
      {
        "title": "レタリエ",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "日本語と英語の手紙を、美しい便箋の上につづる。",
    "category": "Productivity",
    "icon": [
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "binsen"
        ],
        "name": "レタリエの手紙",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Japanese",
          "English"
        ],
        "displayLanguageSelector": true,
        "installMode": "currentUser",
        "installerHooks": "windows/file-association-icon.nsh"
      }
    },
    "resources": {
      "../public/legal/": "legal/",
      "icons/binsen-document.ico": "icons/binsen-document.ico"
    },
    "publisher": "Y-TEC",
    "license": "Apache-2.0"
  }
}
